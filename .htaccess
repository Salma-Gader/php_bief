# Best setup: point the web server's DocumentRoot at public/ so nothing else is reachable.
# This file is for hosts where the whole project sits in the web root (XAMPP's htdocs,
# shared hosting such as InfinityFree): every request is served from public/.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Block private folders and dotfiles (.git, .htaccess, ...).
    RewriteRule ^(config|src|database|bin|storage|vendor)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    # Serve everything from public/: /, /assets/..., /api/book.php, /admin/...
    # (paths here are relative to this folder, so it also works in a sub-folder)
    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
